{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Invoicing": {
    "VatRatePercent": 19,
    "PaymentTermDays": 14,
    "Currency": "EUR",
    "SellerName": "AutoFlow Demo Garage",
    "SellerAddress": "12 Example Street\n10115 Berlin",
    "SellerVatId": null
  },
  "Auth": {
    "Issuer": "autoflow",
    "Audience": "autoflow",
    "TokenLifetime": "08:00:00"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Metrics": {
    "Prometheus": false
  }
}
